APP_USERNAME=
APP_PASSWORD=

# Legacy only. The app itself always runs at /.
APP_BASE_PATH=

GLOBAL_MAX_SLOTS=5
PROD_URL=https://login.mypurecloud.de
PROD_MAX_SLOTS=5
TEST_URL=https://login.mypurecloud.ie
TEST_MAX_SLOTS=5

# Visual alerts only. Sessions are never released automatically because of these limits.
ALERT_AFTER_MINUTES=60
CRITICAL_AFTER_MINUTES=120

AUTO_RELEASE_STALE=false
STALE_AFTER_MINUTES=480

DATABASE_PATH=/app/data/tracker.db
HISTORY_LIMIT=30
