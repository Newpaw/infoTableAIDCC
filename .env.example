# Optional Basic Auth. Leave both empty if access is protected elsewhere (for example Cloudflare Access).
APP_USERNAME=
APP_PASSWORD=
APP_BASE_PATH=

# Overall safety cap across both environments. Set 0 to disable the global cap.
GLOBAL_MAX_SLOTS=5

PROD_URL=https://login.mypurecloud.de
PROD_MAX_SLOTS=5
TEST_URL=https://login.mypurecloud.ie
TEST_MAX_SLOTS=5

# Keep false: a forgotten login should remain visible until somebody manually releases it.
AUTO_RELEASE_STALE=false
STALE_AFTER_MINUTES=480
DATABASE_PATH=data/tracker.db
HISTORY_LIMIT=30
